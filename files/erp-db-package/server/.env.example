# Copy to server/.env and fill in. NEVER commit .env. All values below are placeholders.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. Local replica set example (see README): mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=college_erp_dev
USE_TRANSACTIONS=false

# Sessions (opaque cookie token; only a keyed hash is stored)
SESSION_TOKEN_PEPPER=<generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Private file storage (must be OUTSIDE any public/static directory)
PRIVATE_UPLOAD_DIR=./private-uploads
MAX_UPLOAD_BYTES=10485760

# Password-reset email (placeholders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@college.example

# Seeding (development/test databases only)
ALLOW_SEED=false
SEED_PASSWORD=
