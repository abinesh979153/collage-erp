# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/college_erp

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-different-random-string-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Only used by `npm run create-admin` (first admin bootstrap)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
